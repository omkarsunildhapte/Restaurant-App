APP_ENV=development
PORT=4100
# The platform's Supabase Postgres (shared with the Node API); this API keeps its tables in
# the `crm` schema. Local Supabase: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
# Sign-in is Supabase Auth. Local: http://127.0.0.1:54321 (see `supabase status`).
SUPABASE_URL=
# Server-only: creates team accounts and sets their CRM role. Never put it in a browser app.
SUPABASE_SERVICE_ROLE_KEY=
# Only if the project still signs tokens with the old shared secret (HS256). Leave empty otherwise.
SUPABASE_JWT_SECRET=
# Comma-separated: the Super Admin app and the marketing website.
CORS_ORIGINS=http://localhost:4300,http://localhost:4004,http://localhost:4400
