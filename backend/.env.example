# Copy to .env (git-ignored) and fill in.
# development | staging | production
APP_ENV=development
PORT=4000
# Dev origins: ng serve (4200 customer/delivery, 4201 business-panel, 4300 super-admin), ionic serve (8100),
# SSR servers (4001 business-panel, 4002 customer, 4003 delivery, 4004 super-admin, 4006 staff), staff dev (4500), marketing site (4400), Capacitor Android/iOS
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4300,http://localhost:8100,http://localhost:4001,http://localhost:4002,http://localhost:4003,http://localhost:4004,http://localhost:4006,http://localhost:4500,http://localhost:4400,https://localhost,capacitor://localhost

# Local: values from `supabase status`. Staging/production: Supabase dashboard > Project settings > API.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Business panel address that invite emails link to
CONSOLE_URL=http://localhost:4201

# Geocoding (OpenStreetMap Nominatim, called only from this API: max 1 request/second, cached).
# Required outside development: identify the app and a contact address.
NOMINATIM_USER_AGENT=Thaliyo/0.1 (contact@example.com)
NOMINATIM_URL=https://nominatim.openstreetmap.org/
NOMINATIM_COUNTRY_CODES=in
