{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "description": "Node API for the restaurant platform (api.<domain>)",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "express": "^5.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
