{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://restaurant-platform/schemas/theme.v1.json",
  "title": "Restaurant theme v1",
  "description": "One theme per restaurant brand, shared by the website templates and the customer app. See templates/THEME.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "logo": {
      "type": ["string", "null"],
      "pattern": "^(https://[^\\s\"'<>]+|[a-zA-Z0-9_\\-/]+)\\.(png|webp|PNG|WEBP)(\\?[^\\s\"'<>]*)?$"
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": { "$ref": "#/$defs/hex" },
        "primaryLight": { "$ref": "#/$defs/hex" },
        "primarySoft": { "$ref": "#/$defs/hex" },
        "onDarkAccent": { "$ref": "#/$defs/hex" },
        "dark": { "$ref": "#/$defs/hex" },
        "text": { "$ref": "#/$defs/hex" },
        "muted": { "$ref": "#/$defs/hex" },
        "accent": { "$ref": "#/$defs/hex" },
        "accentDark": { "$ref": "#/$defs/hex" },
        "background": { "$ref": "#/$defs/hex" },
        "surface": { "$ref": "#/$defs/hex" },
        "border": { "$ref": "#/$defs/hex" }
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": { "$ref": "#/$defs/font" },
        "body": { "$ref": "#/$defs/font" },
        "script": { "$ref": "#/$defs/font" }
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "font": { "type": "string", "pattern": "^[A-Za-z0-9 ]{2,40}$" }
  }
}
